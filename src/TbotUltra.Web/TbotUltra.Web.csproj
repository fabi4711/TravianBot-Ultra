<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TbotUltra.Web</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Images the desktop markup references as /Assets/..., served to the browser. -->
    <Content Include="..\..\assets\icons\*.png;..\..\assets\images\*.png;..\..\assets\images\*.jpg"
             Link="wwwroot\assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TbotUltra.Headless\TbotUltra.Headless.csproj" />
  </ItemGroup>
</Project>
