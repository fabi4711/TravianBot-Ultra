<UserControl x:Class="TbotUltra.Desktop.Views.ResourcesHubPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TbotUltra.Desktop.Views">
  <TabControl x:Name="ResourcesTabControl" Background="{DynamicResource AppBackgroundBrush}">
    <TabItem x:Name="ResourcesTabItem" Header="Resources">
      <views:ResourcesPanel x:Name="ResourcesContent" />
    </TabItem>
    <TabItem x:Name="TradingTabItem" Header="Trading">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <views:NpcTradePanel x:Name="TradingContent" Section="Trading" />
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
