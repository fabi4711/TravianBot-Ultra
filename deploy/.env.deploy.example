# cp deploy/.env.deploy.example deploy/.env.deploy — git-ignored, never commit it.

REGISTRY="192.168.2.98:5002"
PORTAINER_URL="http://192.168.2.98:9000"
# Portainer → My account → Access tokens
PORTAINER_API_KEY="ptr_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PORTAINER_ENDPOINT_ID="3"
STACK_NAME="tbot-ultra"
# Must match the Portainer host's architecture.
PLATFORM="linux/arm64"
# VERSION defaults to the short git SHA.
# After a deploy, older tbot-ultra images in the registry are deleted (default: keep 5).
# REGISTRY_KEEP="5"
# REGISTRY_CONTAINER="docker-registry"

HOST_PORT="8090"
VNC_PORT="6080"
TBOT_WEB_PASSWORD="change-me"
VNC_PASSWORD="change-me"
TZ="Europe/Berlin"
